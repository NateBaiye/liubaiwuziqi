# Coturn configuration for Gomoku video calls

listening-port=3478
tls-listening-port=5349

realm=${TURN_SERVER_PUBLIC_HOST}
server-name=${TURN_SERVER_PUBLIC_HOST}

lt-cred-mech
user=${TURN_USERNAME}:${TURN_PASSWORD}

external-ip=${TURN_SERVER_PUBLIC_HOST}

fingerprint
no-multicast-peers
no-cli
min-port=49160
max-port=49200

simple-log
log-file=stdout

# Uncomment and update if you want TLS:
# cert=/etc/letsencrypt/live/${TURN_SERVER_PUBLIC_HOST}/fullchain.pem
# pkey=/etc/letsencrypt/live/${TURN_SERVER_PUBLIC_HOST}/privkey.pem
